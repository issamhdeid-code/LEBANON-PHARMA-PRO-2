{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "SYSTEM_INSTRUCTIONS.md"],
  "model": "opencode/big-pickle",
  "snapshot": false,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", ".cache/**"]
  }
}